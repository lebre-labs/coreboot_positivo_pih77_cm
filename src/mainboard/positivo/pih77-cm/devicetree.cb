chip northbridge/intel/sandybridge
	register "spd_addresses" = "{0x50, 0x51, 0x52, 0x53}"
	device domain 0x0 on
		device ref host_bridge on
			subsystemid 0x1b0a 0x0152
		end
		device ref peg10 on
			subsystemid 0x1b0a 0x0152
		end
		device ref igd on
			subsystemid 0x1b0a 0x0152
		end
		chip southbridge/intel/bd82x6x # Intel 7 Series Panther Point PCH
			register "docking_supported" = "0"
			register "gen1_dec" = "LPC_IO(0xa00, 0x40)"
			register "gen2_dec" = "0x00000000"
			register "gen3_dec" = "0x00000000"
			register "gen4_dec" = "0x00000000"
			register "pcie_hotplug_map" = "{ 0, 0, 0, 0, 0, 0, 0, 0 }"
			register "pcie_port_coalesce" = "1"
			register "sata_interface_speed_support" = "0x3"
			register "sata_port_map" = "0x1f"
			register "spi_lvscc" = "0x2005"
			register "spi_uvscc" = "0x2005"
			register "superspeed_capable_ports" = "0x0000000f"
			register "usb_port_config" = "{
				{1, 6, 0},
				{1, 6, 0},
				{1, 1, 1},
				{1, 1, 1},
				{1, 1, 2},
				{1, 1, 2},
				{1, 6, 3},
				{1, 6, 3},
				{1, 6, 4},
				{1, 6, 4},
				{1, 6, 6},
				{1, 1, 5},
				{1, 1, 5},
				{1, 6, 6},
			}"
			register "xhci_switchable_ports" = "0x0000000f"
			device ref xhci on
				subsystemid 0x1b0a 0x0152
			end
			device ref mei1 off
			end
			device ref mei2 off
			end
			device ref me_ide_r off
			end
			device ref me_kt off
			end
			device ref gbe on
				subsystemid 0x1b0a 0x0152
			end
			device ref ehci2 on
				subsystemid 0x1b0a 0x0152
			end
			device ref hda on
				subsystemid 0x1b0a 0x0153
			end
			device ref pcie_rp1 on
				subsystemid 0x1b0a 0x0152
			end
			device ref pcie_rp2 off
			end
			device ref pcie_rp3 off
			end
			device ref pcie_rp4 on
				subsystemid 0x1b0a 0x0152
			end
			device ref pcie_rp5 on
				subsystemid 0x1b0a 0x0152
			end
			device ref pcie_rp6 off
			end
			device ref pcie_rp7 off
			end
			device ref pcie_rp8 off
			end
			device ref ehci1 on
				subsystemid 0x1b0a 0x0152
			end
			device ref pci_bridge off
			end
			device ref lpc on
				subsystemid 0x1b0a 0x0152
			end
			device ref sata1 on
				subsystemid 0x1b0a 0x0152
			end
			device ref smbus on
				subsystemid 0x1b0a 0x0152
			end
			device ref sata2 off
			end
			device ref thermal on # Unsupported PCI device 8086:1e24
				subsystemid 0x1b0a 0x0152
			end
		end
	end
end
